{
                    "name": "somaprumo-frontend",
                    "version": "0.1.0",
                    "private": true,
                    "type": "module",
                    "scripts": {
                                        "dev": "vite",
                                        "build": "vite build",
                                        "preview": "vite preview",
                                        "type-check": "vue-tsc --noEmit",
                                        "lint": "eslint src",
                                        "test": "vitest",
                                        "test:unit": "vitest --run",
                                        "test:ci": "vitest --run",
                                        "test:e2e": "playwright test",
                                        "test:e2e:ui": "playwright test --ui",
                                        "playwright:install": "playwright install",
                                        "check": "npm run type-check && npm run lint && npm run test:ci && npm run build",
                                        "ci:validate": "npm run check"
                    },
                    "dependencies": {
                                        "pinia": "^2.0.33",
                                        "vue": "^3.4.0",
                                        "vue-router": "^4.2.0"
                    },
                    "devDependencies": {
                                        "@playwright/test": "^1.40.0",
                                        "@testing-library/vue": "^6.1.1",
                                        "@types/node": "^20.0.0",
                                        "@vitejs/plugin-vue": "^6.0.8",
                                        "@vue/eslint-config-typescript": "^14.9.0",
                                        "@vue/test-utils": "^2.3.0",
                                        "eslint": "^9.39.5",
                                        "eslint-config-prettier": "^9.0.0",
                                        "eslint-plugin-vue": "^10.10.0",
                                        "jsdom": "^30.0.1",
                                        "typescript": "^5.3.0",
                                        "vite": "^8.2.2",
                                        "vitest": "^4.1.11",
                                        "vue-tsc": "^3.3.11"
                    }
}