{
                    "compilerOptions": {
                                        "composite": true,
                                        "target": "ES2022",
                                        "module": "ESNext",
                                        "moduleResolution": "Bundler",
                                        "strict": true,
                                        "resolveJsonModule": true,
                                        "esModuleInterop": true,
                                        "allowSyntheticDefaultImports": true,
                                        "isolatedModules": true,
                                        "noEmit": true,
                                        "skipLibCheck": true,
                                        "baseUrl": ".",
                                        "paths": {
                                                            "@/*": [
                                                                        "src/*"
                                                            ]
                                        },
                                        "types": [
                                                            "node",
                                                            "vitest/globals"
                                        ]
                    },
                    "include": [
                                        "src/**/*.ts",
                                        "src/**/*.d.ts",
                                        "src/**/*.vue",
                                        "tests/**/*.ts",
                                        "vite.config.ts",
                                        "vitest.config.ts",
                                        "playwright.config.ts"
                    ]
}